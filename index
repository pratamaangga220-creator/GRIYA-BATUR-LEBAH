<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Griya Batur Lebah</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&family=Marcellus&display=swap">
<style>
/* Tata letak: kop dengan pita poleng, ringkasan satu baris, lalu tab.
   Kalender pawukon (satu baris = satu wuku) berdampingan dengan agenda. */
:root{
  --paras:#F6EBD2; --bg1:#FCF3DE; --bg2:#F5E5C6; --bg3:#EBD8C4; --sinar:rgba(255,190,70,.40); --selubung1:70%; --selubung2:84%;
  --surface:#FBF4E2; --raised:#FFFDF7;
  --ink:#1C1B3A; --muted:#48445F; --line:#D8C59C; --line-soft:#E8DAB8;
  --prada:#8F5400; --prada-fill:#F0B93C; --on-prada:#2A1C00; --hero-bg:#0B0F24; --hero-fg:#F4EFE0; --hero-aksen:#F0C24E;
  --dewa:#8A5600; --rsi:#355A72; --manusa:#A01E63; --pitra:#443F9C; --bhuta:#4F5E17; --ajar:#17645F; --lain:#5A5672;
  --ok:#1F6A3F; --warn:#8F4A00; --crit:#B3261E; --purnama:#D0142C; --tilem:#0A0A0A; --tilem-tepi:transparent;
  --font-display:'Marcellus','Iowan Old Style','Palatino Linotype',Georgia,serif;
  --font-body:'Instrument Sans',system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --paras:#0F1334; --bg1:#090E2A; --bg2:#141238; --bg3:#24123A; --sinar:rgba(240,194,78,.17); --selubung1:74%; --selubung2:86%;
    --surface:#161A45; --raised:#1D2253;
    --ink:#F2EDDD; --muted:#A9A8CA; --line:#363C78; --line-soft:#272C60;
    --prada:#F0C24E; --prada-fill:#F0C24E; --on-prada:#231700; --hero-bg:#0B0F24; --hero-fg:#F4EFE0; --hero-aksen:#F0C24E;
    --dewa:#F0C24E; --rsi:#9CC0DA; --manusa:#F593C7; --pitra:#B4B1FA; --bhuta:#C2D277; --ajar:#84D6CF; --lain:#A9A8CA;
    --ok:#7AD6A2; --warn:#F3AE62; --crit:#FF8F86; --purnama:#FF4658; --tilem:#000000; --tilem-tepi:rgba(242,237,221,.8);
    color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --paras:#0F1334; --bg1:#090E2A; --bg2:#141238; --bg3:#24123A; --sinar:rgba(240,194,78,.17); --selubung1:74%; --selubung2:86%;
  --surface:#161A45; --raised:#1D2253;
  --ink:#F2EDDD; --muted:#A9A8CA; --line:#363C78; --line-soft:#272C60;
  --prada:#F0C24E; --prada-fill:#F0C24E; --on-prada:#231700; --hero-bg:#0B0F24; --hero-fg:#F4EFE0; --hero-aksen:#F0C24E;
  --dewa:#F0C24E; --rsi:#9CC0DA; --manusa:#F593C7; --pitra:#B4B1FA; --bhuta:#C2D277; --ajar:#84D6CF; --lain:#A9A8CA;
  --ok:#7AD6A2; --warn:#F3AE62; --crit:#FF8F86; --purnama:#FF4658; --tilem:#000000; --tilem-tepi:rgba(242,237,221,.8);
  color-scheme:dark;
}
*{box-sizing:border-box}
html{color-scheme:light}
[hidden]{display:none!important}
img{max-width:100%}
body{margin:0;min-height:100vh;background-color:var(--paras);color:var(--ink);font-family:var(--font-body);font-size:15px;line-height:1.5}
.latar{position:fixed;inset:0;z-index:0;pointer-events:none;background-image:linear-gradient(180deg,color-mix(in srgb,var(--bg1) var(--selubung1),transparent) 0%,color-mix(in srgb,var(--bg2) var(--selubung2),transparent) 100%),var(--bgfoto),var(--bgkabur);background-size:auto,var(--bg-ukuran),var(--kabur-ukuran);background-position:0 0,var(--bg-posisi),var(--kabur-posisi);background-repeat:no-repeat}
button,input,select,textarea{font:inherit;color:inherit}
h1,h2,h3,p,ul,ol,dl,dd{margin:0}
ul,ol{padding:0;list-style:none}
:focus-visible{outline:2px solid var(--prada);outline-offset:2px}
.wrap{position:relative;z-index:1;max-width:1180px;margin-inline:auto;padding-inline:clamp(16px,3vw,32px);padding-block:18px 56px;display:flex;flex-direction:column;gap:16px}

/* Kop */
.kop{display:flex;gap:14px 24px;align-items:center;justify-content:space-between}
.kop-teks{display:flex;flex-direction:column;gap:2px;min-width:0}
.kop-teks h1{margin-bottom:3px}
.eyebrow{font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--prada);font-weight:600}
h1{font-family:var(--font-display);font-weight:400;font-size:clamp(25px,5.2vw,44px);line-height:1.1;letter-spacing:.05em;text-wrap:balance}
.alamat{font-size:12px;line-height:1.45;max-width:70ch;overflow-wrap:anywhere}
.alamat a{color:var(--prada);font-weight:600;white-space:nowrap}
.kop-lambang{flex:none;display:flex;align-items:center}
.lambang{width:clamp(60px,9vw,96px);height:clamp(60px,9vw,96px);object-fit:contain;display:block}
.lambang-kosong{width:clamp(60px,9vw,96px);height:clamp(60px,9vw,96px);border:1px dashed var(--line);border-radius:50%;background:transparent;font-size:12px;line-height:1.25;color:var(--muted);cursor:pointer;padding:6px}
.lambang-kosong:hover{border-color:var(--ink);color:var(--ink)}
.hari-ini{color:var(--muted);font-size:12px;line-height:1.45}
.hari-ini b{color:var(--ink);font-weight:600}
.kop-aksi{display:flex;flex-wrap:wrap;gap:8px;align-items:center;padding-bottom:8px}
.tabs-baris{display:flex;flex-wrap:wrap;gap:6px 20px;align-items:flex-end;justify-content:space-between}
.kepala{position:fixed;top:0;left:0;right:0;z-index:20;color:var(--hero-fg);background-color:var(--hero-bg);background-image:linear-gradient(90deg,rgba(7,9,24,.8) 0%,rgba(7,9,24,.62) 50%,rgba(7,9,24,.46) 100%),var(--bgfoto),var(--bgkabur);background-size:auto,var(--bg-ukuran),var(--kabur-ukuran);background-position:0 0,var(--bg-posisi),var(--kabur-posisi);background-repeat:no-repeat;border-bottom:2px solid var(--hero-aksen)}
.kepala .hari-ini{color:rgba(244,239,224,.82)}
.kepala .hari-ini b{color:var(--hero-fg)}
.kepala .alamat a{color:var(--hero-aksen)}
.kepala .tabs button{color:rgba(244,239,224,.78)}
.kepala .tabs button[aria-selected="true"]{color:var(--hero-fg);border-bottom-color:var(--hero-aksen)}
.kepala .lambang-kosong{color:rgba(244,239,224,.85);border-color:rgba(244,239,224,.55)}
.kepala :focus-visible{outline-color:var(--hero-aksen)}
.kepala-dalam{max-width:1180px;margin-inline:auto;padding-inline:clamp(16px,3vw,32px);padding-top:14px;display:flex;flex-direction:column;gap:8px}
.kepala-ganjal{height:var(--tinggi-kepala,180px)}
.gulir .kepala{box-shadow:0 6px 22px rgba(6,8,24,.35)}
.gulir .kepala-dalam{padding-top:8px;gap:2px}
.gulir .alamat,.gulir .hari-ini{display:none}
.gulir .kop-teks h1{font-size:clamp(19px,2.6vw,25px);margin-bottom:0}
.gulir .lambang,.gulir .lambang-kosong{width:38px;height:38px;font-size:0}

/* Tombol */
.btn{border:1px solid var(--line);background:var(--raised);color:var(--ink);padding:7px 13px;border-radius:6px;cursor:pointer;font-weight:500;font-size:14px;line-height:1.3}
.btn:hover{border-color:var(--ink)}
.btn.utama{background:var(--ink);color:var(--paras);border-color:var(--ink)}
.btn.utama:hover{opacity:.88}
.btn.kecil{padding:4px 9px;font-size:13px}
.btn.bahaya{color:var(--crit)}
.btn.bahaya:hover{border-color:var(--crit)}
.btn.polos{border-color:transparent;background:transparent;padding-inline:6px;color:var(--muted);text-decoration:underline;text-underline-offset:3px}
.btn:disabled{opacity:.5;cursor:default}
.seg{display:inline-flex;border:1px solid var(--line);border-radius:6px;overflow:hidden;background:var(--raised)}
.seg button,.seg label{border:0;background:transparent;padding:6px 12px;font-size:14px;cursor:pointer;font-weight:500;color:var(--muted)}
.seg button+button,.seg label+label{border-left:1px solid var(--line)}
.seg button[aria-pressed="true"],.seg label:has(input:checked){background:var(--ink);color:var(--paras)}
.seg input{position:absolute;opacity:0;pointer-events:none}
.seg label:has(input:focus-visible){outline:2px solid var(--prada);outline-offset:-2px}

/* Ringkasan */
.ringkasan{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:14px 20px}
.stat{border-top:2px solid var(--ink);padding-top:9px;display:flex;flex-direction:column;gap:2px;min-width:0}
.stat-label{font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);font-weight:600}
.stat-nilai{font-family:var(--font-display);font-size:24px;line-height:1.2;font-variant-numeric:tabular-nums;overflow-wrap:anywhere}
.stat-ket{font-size:13px;color:var(--muted);overflow-wrap:anywhere}
.stat.kritis{border-top-color:var(--crit)} .stat.kritis .stat-nilai{color:var(--crit)}
.stat.awas{border-top-color:var(--warn)} .stat.awas .stat-nilai{color:var(--warn)}

/* Tab */
.tabs{display:flex;gap:4px 22px;flex-wrap:wrap}
.tabs button{border:0;background:transparent;padding:8px 0;font-size:15px;font-weight:600;color:var(--muted);cursor:pointer;border-bottom:3px solid transparent;margin-bottom:-2px}
.tabs button[aria-selected="true"]{color:var(--ink);border-bottom-color:var(--prada-fill)}
.pratinjau{font-size:13px;color:var(--warn);border:1px dashed var(--warn);padding:6px 10px;border-radius:6px}

h2{font-family:var(--font-display);font-weight:400;font-size:21px;line-height:1.25;text-wrap:balance}
h3{font-size:13px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);font-weight:600}
.dua{display:grid;grid-template-columns:minmax(0,1.12fr) minmax(0,1fr);gap:28px 32px;align-items:start}
.kol{display:flex;flex-direction:column;gap:18px;min-width:0}
.blok{display:flex;flex-direction:column;gap:10px;min-width:0}
.baris-judul{display:flex;flex-wrap:wrap;gap:8px 12px;align-items:center;justify-content:space-between}
.muted{color:var(--muted)} .kecil{font-size:13px}

/* Kalender */
.kal-nav{display:flex;gap:6px;align-items:center}
.kal{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:3px}
.kal-h{font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);font-weight:600;text-align:center;padding-block:2px}
.kal-h .panjang{display:none}
.wk{grid-column:1/-1;display:flex;align-items:center;gap:8px;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);font-weight:600;margin-top:5px}
.wk::after{content:"";flex:1;height:1px;background:var(--line-soft)}
.sel{border:1px solid var(--line-soft);background:var(--raised);border-radius:4px;min-height:58px;padding:4px 5px;display:flex;flex-direction:column;gap:3px;cursor:pointer;text-align:left;min-width:0}
.sel:hover{border-color:var(--ink)}
.sel.luar{background:transparent;color:var(--muted)}
.sel.luar .tg{color:var(--muted)}
.sel.kini{border-color:var(--prada);box-shadow:inset 0 0 0 1px var(--prada)}
.sel.pilih{background:var(--ink);color:var(--paras);border-color:var(--ink)}
.sel.pilih .pw,.sel.pilih .tg{color:var(--paras)}
.sel-atas{display:flex;justify-content:space-between;align-items:baseline;gap:2px}
.tg{font-weight:600;font-size:14px;font-variant-numeric:tabular-nums}
.pw{font-size:10px;color:var(--muted);letter-spacing:.02em}
.pw .panjang{display:none}
.tanda{display:flex;flex-wrap:wrap;gap:2px;align-items:center;margin-top:auto}
.wajik{width:7px;height:7px;background:var(--prada-fill);transform:rotate(45deg);margin:1px 3px 1px 1px;flex:none;border:1px solid var(--prada)}
.bulan{width:10px;height:10px;border-radius:50%;flex:none;margin-right:2px;display:inline-block}
.bulan.purnama{background:var(--purnama)}
.bulan.tilem{background:var(--tilem);box-shadow:0 0 0 1px var(--tilem-tepi)}
.sel.pilih .bulan{box-shadow:0 0 0 1px var(--paras)}
.rer .bulan{margin-right:6px}
.bar{width:13px;height:5px;border-radius:2px;background:var(--c);flex:none}
.sel.pilih .bar{outline:1px solid var(--paras)}
.lebih{font-size:10px;line-height:1}
.legenda{display:flex;flex-wrap:wrap;gap:4px 14px;font-size:12px;color:var(--muted)}
.legenda span{display:inline-flex;align-items:center;gap:5px}
.rer{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:4px 18px;font-size:13px}
.rer li{display:flex;gap:8px;min-width:0}
.rer .t{font-variant-numeric:tabular-nums;color:var(--muted);flex:none;width:44px}
.pilihan{border-left:3px solid var(--prada-fill);padding:2px 0 2px 12px;display:flex;flex-direction:column;gap:8px}

/* Agenda hari ini */
.hariini{border:1px solid var(--line);border-left:5px solid var(--prada-fill);border-radius:8px;background:var(--raised);padding:12px 16px;display:flex;flex-direction:column;gap:8px;min-width:0}
.hi-tgl{font-size:14px;overflow-wrap:anywhere}
.hi-jml{font-family:var(--font-display);font-size:22px;white-space:nowrap}
.hi-daftar{display:flex;flex-direction:column}
.hi-baris{display:flex;flex-direction:column;gap:1px;text-align:left;border:0;border-top:1px solid var(--line-soft);border-left:4px solid var(--c);background:transparent;padding:7px 10px;cursor:pointer;width:100%}
.hi-baris:hover{background:var(--surface)}
.hi-baris b{font-weight:600;overflow-wrap:anywhere}
.hi-baris span{font-size:13px;color:var(--muted);overflow-wrap:anywhere}

/* Agenda */
.saring{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
.saring select{width:auto;flex:1 1 170px;max-width:100%}
.baris-judul select{width:auto;max-width:100%;flex:0 1 auto}
.agenda{display:flex;flex-direction:column;border-top:1px solid var(--line)}
.ag{display:grid;grid-template-columns:52px minmax(0,1fr);gap:12px;padding:12px 4px;border:0;border-bottom:1px solid var(--line);background:transparent;text-align:left;cursor:pointer;width:100%}
.ag:hover{background:var(--surface)}
.ag-tgl{display:flex;flex-direction:column;align-items:center;border-left:4px solid var(--c);padding-left:6px}
.ag-tgl b{font-family:var(--font-display);font-weight:400;font-size:25px;line-height:1.05;font-variant-numeric:tabular-nums}
.ag-tgl span{font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
.ag-isi{display:flex;flex-direction:column;gap:3px;min-width:0}
.ag-judul{font-weight:600;font-size:15px;overflow-wrap:anywhere}
.ag-baris{font-size:13px;color:var(--muted);overflow-wrap:anywhere}
.pills{display:flex;flex-wrap:wrap;gap:5px;align-items:center;margin-top:2px}
.pill{font-size:12px;line-height:1.3;padding:1px 8px;border-radius:999px;color:var(--c,var(--muted));border:1px solid color-mix(in srgb,var(--c,var(--muted)) 45%,transparent);background:color-mix(in srgb,var(--c,var(--muted)) 10%,transparent);font-weight:500;white-space:nowrap}
.pill.isi{background:var(--c);color:var(--paras);border-color:var(--c)}
.meter{height:5px;background:var(--line-soft);border-radius:3px;overflow:hidden;min-width:60px;flex:1;max-width:160px}
.meter i{display:block;height:100%;background:var(--ok);border-radius:3px}
.kosong{border:1px dashed var(--line);border-radius:8px;padding:22px 18px;display:flex;flex-direction:column;gap:10px;align-items:flex-start;background:var(--surface)}
.kosong p{max-width:58ch}

.paging{display:flex;align-items:center;justify-content:space-between;gap:10px;padding-top:12px}
.paging span{font-size:13px;color:var(--muted);font-variant-numeric:tabular-nums;text-align:center}

/* Beranda */
.hero{position:relative;isolation:isolate;border-radius:12px;overflow:hidden;background:var(--hero-bg);color:var(--hero-fg);min-height:clamp(440px,64vh,640px);display:flex;align-items:flex-end}
.slides,.slide,.slide i{position:absolute;inset:0}
.slide{opacity:0;transition:opacity 1.4s ease}
.slide.aktif{opacity:1}
.slide i{background-size:cover;background-repeat:no-repeat}
.slide .kabur{background-image:var(--bg);background-position:50% 50%}
.slide .tajam{background-image:var(--img);background-position:var(--pos,50% 45%);left:auto;width:50%;-webkit-mask-image:linear-gradient(90deg,transparent 0,#000 18%);mask-image:linear-gradient(90deg,transparent 0,#000 18%)}
.hero::after{content:"";position:absolute;inset:0;z-index:1;pointer-events:none;background:linear-gradient(90deg,rgba(8,11,26,.86) 0%,rgba(8,11,26,.66) 44%,rgba(8,11,26,0) 66%)}
.hero-teks{position:relative;z-index:2;width:54%;padding:clamp(22px,4.4vw,52px);display:flex;flex-direction:column;gap:14px;min-width:0}
.hero .eyebrow{color:var(--hero-aksen)}
.hero h2{font-size:clamp(34px,5.6vw,60px);line-height:1.04}
.hero p.lead{max-width:48ch;font-size:16px;line-height:1.6;opacity:.93}
.hero-alat{position:absolute;z-index:3;top:12px;right:12px;display:flex;flex-wrap:wrap;gap:8px;justify-content:flex-end}
.foto-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(104px,1fr));gap:12px 10px}
.foto-item{display:flex;flex-direction:column;gap:5px;min-width:0}
.foto-item i{display:block;aspect-ratio:3/4;border-radius:6px;border:1px solid var(--line);background-image:var(--img);background-size:cover;background-position:var(--pos,50% 40%)}
.foto-item span{font-size:12px;color:var(--muted)}
.titik{position:absolute;z-index:2;right:14px;bottom:12px;display:flex;gap:2px}
.titik button{width:22px;height:22px;border:0;background:transparent;padding:0;cursor:pointer;display:grid;place-items:center}
.titik button::before{content:"";width:8px;height:8px;border-radius:50%;border:1px solid var(--hero-fg);background:transparent}
.titik button[aria-pressed="true"]::before{background:var(--hero-aksen);border-color:var(--hero-aksen)}
.titik button:focus-visible{outline-color:var(--hero-aksen)}
.bagian{display:flex;flex-direction:column;gap:14px;min-width:0}
.bagian>.pengantar{max-width:66ch;color:var(--muted)}
.rute{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));counter-reset:st}
.rute li{position:relative;padding:28px 18px 0 0;counter-increment:st;display:flex;flex-direction:column;gap:4px;min-width:0}
.rute li::before{content:"";position:absolute;top:8px;left:0;right:0;height:2px;background:var(--line)}
.rute li::after{content:"";position:absolute;top:2px;left:1px;width:12px;height:12px;background:var(--prada-fill);border:1px solid var(--prada);transform:rotate(45deg)}
.rute .ke{font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--prada);font-weight:600}
.rute .ke::after{content:" " counter(st)}
.rute b{font-family:var(--font-display);font-weight:400;font-size:20px;line-height:1.2}
.rute span.isi{font-size:14px;color:var(--muted)}
.jejak{display:flex;flex-direction:column;border-top:1px solid var(--ink)}
.jejak li{display:grid;grid-template-columns:132px minmax(0,1fr);gap:8px 18px;padding:13px 0;border-bottom:1px solid var(--line-soft)}
.jejak .masa{font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--prada);font-weight:600;padding-top:3px}
.jejak b{font-family:var(--font-display);font-weight:400;font-size:18px;display:block}
.jejak p{color:var(--muted);font-size:14px;max-width:60ch}
.loka{display:flex;flex-direction:column;border:1px solid var(--ink);border-radius:8px;overflow:hidden}
.loka div{display:grid;grid-template-columns:110px minmax(0,1fr);gap:12px;padding:11px 14px;border-bottom:1px solid var(--line);align-items:baseline}
.loka div:last-child{border-bottom:0;background:var(--ink);color:var(--paras)}
.loka .lk{font-size:12px;letter-spacing:.1em;text-transform:uppercase;font-weight:600}
.loka .sd{font-family:var(--font-display);font-size:18px}
.loka small{display:block;font-family:var(--font-body);font-size:13px;opacity:.82}
.genta{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:16px 22px}
.genta li{border-top:2px solid var(--prada-fill);padding-top:9px;display:flex;flex-direction:column;gap:3px;min-width:0}
.genta b{font-family:var(--font-display);font-weight:400;font-size:19px}
.genta span{font-size:14px;color:var(--muted)}
.sumber{font-size:13px;color:var(--muted);max-width:82ch}
.sumber a{color:inherit}

/* Papan bulanan */
.papan-kol{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:26px 32px;align-items:start}
.papan{display:flex;flex-direction:column}
.pp{display:grid;grid-template-columns:28px 58px minmax(0,1fr);gap:10px;align-items:baseline;padding:7px 4px 7px 8px;border:0;border-bottom:1px solid var(--line-soft);border-left:4px solid var(--c);background:transparent;text-align:left;cursor:pointer;width:100%}
.pp:hover{background:var(--surface)}
.pp-tg{font-family:var(--font-display);font-size:19px;line-height:1.2;text-align:right;font-variant-numeric:tabular-nums}
.pp-hr{font-size:12px;color:var(--muted);white-space:nowrap}
.pp-isi{display:flex;flex-direction:column;min-width:0}
.pp-isi b{font-weight:600;overflow-wrap:anywhere}
.pp-isi span{font-size:13px;color:var(--muted);overflow-wrap:anywhere}
.pp.lewat .pp-tg,.pp.lewat .pp-isi b{color:var(--muted);font-weight:400}
.pp.kini{background:color-mix(in srgb,var(--prada-fill) 18%,transparent)}

/* Detail */
.fakta{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px 24px}
.fakta div{display:flex;flex-direction:column;gap:1px;min-width:0}
.fakta dt{font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);font-weight:600}
.fakta dd{overflow-wrap:anywhere}
.catat{border-left:3px solid var(--line);padding-left:12px;max-width:68ch;white-space:pre-wrap;overflow-wrap:anywhere}
.dalam{border:1px solid var(--line);border-radius:8px;padding:12px 14px;background:var(--surface);display:flex;flex-direction:column;gap:6px}
.peringatan{border:1px solid var(--warn);border-radius:8px;padding:10px 14px;color:var(--warn);background:color-mix(in srgb,var(--warn) 8%,transparent);display:flex;flex-direction:column;gap:6px}
.peringatan.kritis{border-color:var(--crit);color:var(--crit);background:color-mix(in srgb,var(--crit) 8%,transparent)}
.cek{display:flex;gap:9px;align-items:flex-start;cursor:pointer}
.cek input{width:18px;height:18px;margin:2px 0 0;accent-color:var(--ok);flex:none}
.aksi{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
.kel{display:flex;flex-direction:column;gap:2px}
.kel-kop{display:flex;flex-wrap:wrap;gap:4px 12px;align-items:baseline;justify-content:space-between;border-bottom:1px solid var(--ink);padding-bottom:5px}
.kel-kop .nm{font-family:var(--font-display);font-size:18px}
.kel-kop .sub{font-size:13px;color:var(--muted)}
.bt{display:grid;grid-template-columns:auto minmax(0,1fr) auto auto;gap:4px 12px;align-items:start;padding:8px 2px;border-bottom:1px solid var(--line-soft)}
.bt.tanpa-cek{grid-template-columns:minmax(0,1fr) auto}
.bt input[type=checkbox]{width:19px;height:19px;margin:2px 0 0;accent-color:var(--ok)}
.bt-nm{display:flex;flex-direction:column;gap:1px;min-width:0}
.bt-nm b{font-weight:500;overflow-wrap:anywhere}
.bt.siap .bt-nm b{color:var(--muted);text-decoration:line-through;text-decoration-color:var(--line)}
.bt-nm span{font-size:13px;color:var(--muted);overflow-wrap:anywhere}
.bt-jml{font-variant-numeric:tabular-nums;white-space:nowrap;text-align:right;font-weight:500}
.pj{color:var(--rsi)}

/* Tabel rekap */
.gulir{overflow-x:auto;border:1px solid var(--line);border-radius:8px;background:var(--raised)}
table{border-collapse:collapse;width:100%;font-size:14px;min-width:520px}
th,td{text-align:left;padding:8px 12px;border-bottom:1px solid var(--line-soft);vertical-align:top}
th{font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);font-weight:600;background:var(--surface)}
td.n,th.n{text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap}
tr.grup td{font-family:var(--font-display);font-size:16px;background:var(--surface);border-bottom:1px solid var(--line)}
tbody tr:last-child td{border-bottom:0}

/* Acuan */
.keping{display:flex;flex-wrap:wrap;gap:6px}
.keping button{border:1px solid color-mix(in srgb,var(--c) 45%,transparent);color:var(--c);background:color-mix(in srgb,var(--c) 8%,transparent);border-radius:999px;padding:4px 12px;font-size:14px;cursor:pointer;font-weight:500}
.keping button[aria-pressed="true"]{background:var(--c);color:var(--paras);border-color:var(--c)}
.prosa{max-width:66ch;display:flex;flex-direction:column;gap:10px}
.rangkaian{counter-reset:r;display:flex;flex-direction:column;gap:5px;max-width:66ch}
.rangkaian li{counter-increment:r;display:grid;grid-template-columns:26px minmax(0,1fr);gap:6px}
.rangkaian li::before{content:counter(r);font-variant-numeric:tabular-nums;color:var(--prada);font-weight:600}
details{border-bottom:1px solid var(--line-soft);padding:8px 2px}
summary{cursor:pointer;font-weight:600}
details p{margin-top:5px;color:var(--muted);max-width:66ch}
.kaki{font-size:13px;color:var(--muted);border-top:1px solid var(--line);padding-top:14px;display:flex;flex-direction:column;gap:6px}
.kaki p{max-width:82ch}

/* Dialog */
dialog{border:1px solid var(--line);border-radius:10px;padding:0;background:var(--raised);color:var(--ink);width:min(600px,calc(100vw - 24px));max-height:calc(100dvh - 32px)}
dialog::backdrop{background:rgba(10,14,11,.5)}
.dlg{display:flex;flex-direction:column;gap:14px;padding:18px 20px 20px}
.form{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px 14px}
.form .lebar{grid-column:1/-1}
.f{display:flex;flex-direction:column;gap:4px;min-width:0}
.f>label,.f>.lbl{font-size:13px;font-weight:600}
.f small{font-size:12px;color:var(--muted)}
input[type=text],input[type=date],input[type=time],input[type=number],input[type=tel],select,textarea{border:1px solid var(--line);border-radius:6px;background:var(--surface);padding:7px 9px;width:100%;min-width:0}
textarea{resize:vertical;min-height:62px}
.dlg-aksi{display:flex;flex-wrap:wrap;gap:8px;justify-content:flex-end;align-items:center}
.dlg-aksi .kiri{margin-right:auto}
.berkas{display:flex;flex-direction:column;gap:16px}
.berkas>div{display:flex;flex-direction:column;gap:5px;align-items:flex-start}
.berkas p{max-width:58ch}
#toast{position:fixed;left:50%;transform:translateX(-50%);bottom:calc(18px + env(safe-area-inset-bottom,0px));background:var(--ink);color:var(--paras);padding:9px 16px;border-radius:8px;font-size:14px;max-width:calc(100vw - 32px);z-index:50;box-shadow:0 4px 18px rgba(0,0,0,.25)}

@media (min-width:900px){ .kal-h .panjang,.pw .panjang{display:inline} .kal-h .pendek,.pw .pendek{display:none} .sel{min-height:68px;padding:6px 7px} }
