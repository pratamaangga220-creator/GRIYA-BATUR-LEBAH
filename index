$('fBanten').addEventListener('submit', ev => {
  ev.preventDefault();
  if (!$('fBanten').reportValidity()) return;
  const { idUp, idBaris } = S.suntingBaris || {}; if (!idUp) return;
  const idB = idBaris || 'b' + Date.now().toString(36) + Math.random().toString(36).slice(2, 6);
  const jml = Number($('bJumlah').value), data = { k: $('bKel').value, n: $('bNama').value.trim(), j: Number.isFinite(jml) ? jml : 1, s: $('bSatuan').value.trim(), c: $('bCatatan').value.trim() };
  if (!data.n) return;
  ubahJadwal(idUp, b => {
    b.banten = b.banten || [];
    const x = b.banten.find(y => y.id === idB);
    if (x) Object.assign(x, data); else b.banten.push({ id: idB, ...data, ok: false });
  });
  const dl = S.dalam.get(idUp) || {}, pj = $('bPj').value.trim(), pjLama = (dl.pj && dl.pj[idB]) || '';
  if (pj !== pjLama) { const baru = { kontak: dl.kontak || '', catatan: dl.catatan || '', pj: salinan(dl.pj || {}) }; if (pj) baru.pj[idB] = pj; else delete baru.pj[idB]; simpan('dalam', idUp, baru); }
  $('dlgBanten').close();
