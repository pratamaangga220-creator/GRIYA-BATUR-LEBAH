    : h('button', { class: 'btn polos kecil', type: 'button', 'data-fk': 'masuk', onclick: () => { S.bolehTulis = true; simpanLokal('griya', '1'); gantiMode('griya'); toast('Mode griya aktif di browser ini.'); }, text: 'Mode griya: ubah jadwal dan banten' })));
