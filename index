  else if (t.kosong) el.textContent = 'Pilih jenis upacara agar daftar banten bisa disusun.';
  else if (!LV[lv]) el.textContent = 'Pilih tingkatan agar daftar banten bisa disusun.';
  else { const a = barisAcuan(j, lv); el.textContent = 'Daftar ' + a.rows.length + ' butir banten tersedia dari ' + (a.sumber === 'griya' ? 'acuan griya.' : 'draf acuan umum.'); }
}
function bukaUpacara(id, tanggal) {
  if (!S.db) return;
  S.sunting = id || null;
  const e = id ? S.jadwal.get(id) : null, dl = (id && S.dalam.get(id)) || {};
  $('dlgUpacaraJudul').textContent = e ? 'Ubah upacara' : 'Tambah upacara';
  const sj = $('fJenis');
  if (!sj.options.length) {
    for (const [yk, yn] of Object.entries(YADNYA)) { const og = h('optgroup', { label: yn }); URUT.filter(k => UP[k].yadnya === yk).forEach(k => og.append(h('option', { value: k, text: UP[k].nama }))); if (og.children.length) sj.append(og); }
  }
  const sul = new Map(); for (const [, x] of S.jadwal) if (x && norm(x.sulinggih)) sul.set(norm(x.sulinggih), x.sulinggih.trim());
  $('dlSulinggih').replaceChildren(...[...sul.values()].map(v => h('option', { value: v })));
  $('fTanggal').value = e ? e.tanggal : (tanggal || hariIniIso());
  $('fMulai').value = e ? e.mulai || '' : ''; $('fSelesai').value = e ? e.selesai || '' : '';
  sj.value = e && UP[e.jenis] ? e.jenis : 'piodalan';
  const lv = e ? (LV[e.lv] ? e.lv : 'x') : 'm'; $('fLv' + lv.toUpperCase()).checked = true;
  $('fJudul').value = e ? e.judul || '' : ''; $('fLokasi').value = e ? e.lokasi || '' : '';
  $('fYajamana').value = e ? e.yajamana || '' : ''; $('fSulinggih').value = e ? e.sulinggih || '' : '';
  $('fCatatan').value = e ? e.catatan || '' : ''; $('fKontak').value = dl.kontak || ''; $('fInternal').value = dl.catatan || '';
  $('fSusun').checked = false; $('fSusunWadah').hidden = !e;
  ketTanggal(); ketSumber();
