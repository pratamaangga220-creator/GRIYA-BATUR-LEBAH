<script>
(() => {
'use strict';
const ASLI = document.documentElement.outerHTML;
const B = JSON.parse(document.getElementById('data-bawaan').textContent);
const KUNCI = 'gbl.data.' + B.versi, KUNCI_DALAM = 'gbl.dalam';

/* ---------- Pawukon ---------- */
const HARI = 86400000;
const SAPTA = ['Redite','Soma','Anggara','Buda','Wraspati','Sukra','Saniscara'];
const PANCA = ['Umanis','Paing','Pon','Wage','Kliwon'];
const WUKU = ['Sinta','Landep','Ukir','Kulantir','Tolu','Gumbreg','Wariga','Warigadean','Julungwangi','Sungsang','Dungulan','Kuningan','Langkir','Medangsia','Pujut','Pahang','Krulut','Merakih','Tambir','Medangkungan','Matal','Uye','Menail','Prangbakat','Bala','Ugu','Wayang','Kelawu','Dukut','Watugunung'];
const BULAN = ['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'];
const BLN = ['Jan','Feb','Mar','Apr','Mei','Jun','Jul','Agu','Sep','Okt','Nov','Des'];

const pad = n => String(n).padStart(2, '0');
const isoDari = (y, m, d) => y + '-' + pad(m) + '-' + pad(d);
const keNomor = iso => { const [y, m, d] = String(iso).split('-').map(Number); return Math.round(Date.UTC(y, m - 1, d) / HARI); };
const keIso = n => new Date(n * HARI).toISOString().slice(0, 10);
const tanggalValid = iso => /^\d{4}-\d{2}-\d{2}$/.test(String(iso || '')) && !Number.isNaN(keNomor(iso));
function hariIniIso() {
  try { return new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Makassar', year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date()); }
  catch (e) { return new Date(Date.now() + 8 * 3600000).toISOString().slice(0, 10); }
}
// Patokan: Buda Kliwon Dungulan (Galungan) 17 Juni 2026 adalah hari ke-73 dari 210 (Redite Paing Sinta = 0).
const PATOKAN = keNomor('2026-06-17');
function pawukon(n) {
  const p = (((n - PATOKAN + 73) % 210) + 210) % 210;
  return { p, sapta: p % 7, panca: (p + 1) % 5, tri: p % 3, wuku: Math.floor(p / 7) };
}
const BERNAMA = { 0: 'Banyu Pinaruh', 1: 'Soma Ribek', 2: 'Sabuh Mas', 3: 'Pagerwesi', 13: 'Tumpek Landep', 48: 'Tumpek Wariga', 67: 'Sugihan Jawa', 68: 'Sugihan Bali', 72: 'Penampahan Galungan', 73: 'Galungan', 74: 'Umanis Galungan', 83: 'Kuningan', 108: 'Pegat Uwakan', 118: 'Tumpek Krulut', 153: 'Tumpek Kandang', 188: 'Tumpek Wayang', 209: 'Saraswati' };
// Penanggal: tiap hari satu tithi; tiap 63 hari ada satu hari yang memuat dua tithi (ngunaratri).
// Tetapan dicocokkan dengan daftar purnama dan tilem 2026 dan 2027 serta malam Nyepi 2019 sampai 2028.
const AWAL_TITHI = keNomor('2026-01-01');
const tithiAkhir = n => { const k = n - AWAL_TITHI; return k + Math.floor((k - 33) / 63) + 14; };
function faseBulan(n) {
  for (let t = tithiAkhir(n - 1) + 1; t <= tithiAkhir(n); t++) { const m = ((t % 30) + 30) % 30; if (m === 15) return 'purnama'; if (m === 0) return 'tilem'; }
  return null;
}
function rerahinan(n) {
  const w = pawukon(n), out = [], bl = faseBulan(n);
  if (bl) out.push({ nama: bl === 'purnama' ? 'Purnama' : 'Tilem', utama: true, bulan: bl });
  if (BERNAMA[w.p]) out.push({ nama: BERNAMA[w.p], utama: true });
  else if (w.panca === 4 && w.sapta === 2) out.push({ nama: 'Anggara Kasih ' + WUKU[w.wuku], utama: false });
  else if (w.panca === 4 && w.sapta === 3) out.push({ nama: 'Buda Kliwon ' + WUKU[w.wuku], utama: false });
  else if (w.panca === 3 && w.sapta === 3) out.push({ nama: 'Buda Cemeng ' + WUKU[w.wuku], utama: false });
  if (w.panca === 4 && w.tri === 2) out.push({ nama: 'Kajeng Kliwon', utama: false });
