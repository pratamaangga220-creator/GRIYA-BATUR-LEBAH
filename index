}
$('fTanggal').addEventListener('input', ketTanggal);
$('fJenis').addEventListener('change', ketSumber);
document.querySelectorAll('input[name="fLv"]').forEach(r => r.addEventListener('change', ketSumber));
$('fBatal').addEventListener('click', () => $('dlgUpacara').close());
$('fUpacara').addEventListener('submit', ev => {
  ev.preventDefault();
  const f = $('fUpacara'); if (!f.reportValidity()) return;
  const tanggal = $('fTanggal').value; if (!tanggalValid(tanggal)) { toast('Isi tanggal lebih dulu.'); return; }
  const lama = S.sunting ? S.jadwal.get(S.sunting) : null;
  const id = S.sunting || idBaru();
  const jenis = $('fJenis').value, lv = lvForm();
  const isi = lama ? salinan(lama) : { banten: [], dikoreksi: false, dibuat: new Date().toISOString() };
  Object.assign(isi, { tanggal, mulai: $('fMulai').value, selesai: $('fSelesai').value, jenis, lv, judul: $('fJudul').value.trim(), lokasi: $('fLokasi').value.trim(), yajamana: $('fYajamana').value.trim(), sulinggih: $('fSulinggih').value.trim(), catatan: $('fCatatan').value.trim() });
  if (!lama || $('fSusun').checked || !(lama.banten || []).length) { isi.banten = barisBaru(jenis, lv); isi.dikoreksi = false; }
  simpan('jadwal', id, isi);
  const dlLama = S.dalam.get(id) || {}, kontak = $('fKontak').value.trim(), cat = $('fInternal').value.trim();
  if (kontak !== (dlLama.kontak || '') || cat !== (dlLama.catatan || '')) simpan('dalam', id, { kontak, catatan: cat, pj: salinan(dlLama.pj || {}) });
  S.sel = id; const [y, m] = tanggal.split('-').map(Number); S.bulan = { y, m };
  $('dlgUpacara').close();
  toast(lama ? 'Perubahan disimpan.' : 'Agenda ditambahkan.');
  if (!lama) bukaTab('banten'); else tampil();
});

/* ---------- Dialog banten ---------- */
function bukaBanten(idUp, idBaris, kel) {
  const e = S.jadwal.get(idUp); if (!e) return;
  S.suntingBaris = { idUp, idBaris: idBaris || null };
  const r = idBaris ? (e.banten || []).find(x => x.id === idBaris) : null, dl = S.dalam.get(idUp) || {};
  $('dlgBantenJudul').textContent = r ? 'Ubah banten' : 'Tambah banten';
  const sk = $('bKel'); if (!sk.options.length) KEL.forEach(([k, nm]) => sk.append(h('option', { value: k, text: nm })));
  sk.value = r ? r.k : (kel || 'ayaban');
  $('bNama').value = r ? r.n : ''; $('bJumlah').value = r ? r.j : 1; $('bSatuan').value = r ? r.s || '' : 'soroh';
  $('bCatatan').value = r ? r.c || '' : ''; $('bPj').value = (r && dl.pj && dl.pj[r.id]) || '';
  $('bHapus').hidden = !r; delete $('bHapus').dataset.yakin; $('bHapus').textContent = 'Hapus';
