        g && a.sumber === 'griya' ? h('button', { class: 'btn kecil bahaya', type: 'button', 'data-fk': 'kd', onclick: ev => duaLangkah(ev.currentTarget, 'Ketuk lagi untuk mengembalikan', () => { hapus('acuan', j + '-' + lv); toast('Kembali ke draf umum.'); }), text: 'Kembalikan ke draf umum' }) : null),
      g && a.sumber === 'draf' ? h('p', { class: 'muted kecil', style: 'max-width:60ch', text: 'Untuk mengoreksi: buat satu upacara dengan jenis dan tingkatan ini, ubah daftarnya, centang sudah sesuai pituduh, lalu pilih Jadikan acuan griya.' }) : null,
      daftar));
}

/* ---------- Dialog upacara ---------- */
function ketTanggal() {
  const v = $('fTanggal').value, el = $('fTanggalKet');
  if (!tanggalValid(v)) { el.textContent = ''; return; }
  const d = keNomor(v), rr = rerahinan(d); el.textContent = wewaran(d) + (rr.length ? ' · ' + rr.map(r => r.nama).join(', ') : '');
}
const lvForm = () => { const c = document.querySelector('input[name="fLv"]:checked'); return c ? c.value : 'm'; };
function ketSumber() {
  const j = $('fJenis').value, t = UP[j], lv = lvForm(), el = $('fSumber');
  if (!t) { el.textContent = ''; return; }
