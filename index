  isi.push(S.tab === 'beranda' ? vBeranda() : S.tab === 'banten' ? vBanten() : S.tab === 'rekap' ? vRekap() : S.tab === 'acuan' ? vAcuan() : S.tab === 'jadwal' ? vJadwal() : vBeranda());
  p.replaceChildren(h('div', { class: 'kol' }, isi));
  vKaki(); ukurKepala();
  if (fk) { const el = document.querySelector('[data-fk="' + (window.CSS && CSS.escape ? CSS.escape(fk) : fk) + '"]'); if (el) el.focus({ preventScroll: true }); }
}

function mulai() {
  const hash = (location.hash || '').slice(1), tabLama = bacaLokal('tab');
  if (TAB.some(t => t[0] === hash)) S.tab = hash; else if (TAB.some(t => t[0] === tabLama)) S.tab = tabLama;
  let L = null, D = null;
  try { L = JSON.parse(localStorage.getItem(KUNCI) || 'null'); D = JSON.parse(localStorage.getItem(KUNCI_DALAM) || 'null'); } catch (e) {}
  const pakaiLokal = !!(L && L.jadwal && typeof L.jadwal === 'object');
  isiDari(pakaiLokal ? L : B); S.kotor = pakaiLokal;
  try { const Lf = JSON.parse(localStorage.getItem(KUNCI + '.foto') || 'null'); if (Lf) { S.foto = normalFoto(Lf); terapkanFoto(); S.kotor = true; } } catch (e) {}
  if (D && typeof D === 'object') S.dalam = new Map(Object.entries(D));
