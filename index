$('bBatal').addEventListener('click', () => $('dlgBanten').close());
$('bHapus').addEventListener('click', ev => duaLangkah(ev.currentTarget, 'Ketuk lagi untuk menghapus', () => {
  const { idUp, idBaris } = S.suntingBaris || {}; if (!idBaris) return;
