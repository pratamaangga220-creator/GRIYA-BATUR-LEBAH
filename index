  .rute{grid-template-columns:minmax(0,1fr)} .rute li{padding:0 0 20px 30px} .rute li::before{top:0;bottom:0;left:6px;right:auto;width:2px;height:auto} .rute li::after{top:4px;left:0} .rute li:last-child{padding-bottom:0} }
